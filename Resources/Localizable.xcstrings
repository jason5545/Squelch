    "帳號": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "zh-Hans": {
