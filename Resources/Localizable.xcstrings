    "yt-dlp 新版下載失敗。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't download the new version of yt-dlp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp の新しい版をダウンロードできませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 新版下载失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 新版下載失敗。"
          }
        }
      }
    },
    "yt-dlp 新版的雜湊值不符，沒有換上去。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new version of yt-dlp failed its checksum and was not installed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp の新しい版のハッシュ値が一致しないため、入れ替えませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 新版的哈希值不符，没有换上去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 新版的雜湊值不符，沒有換上去。"
          }
        }
      }
    },
